// Base de datos de jugadores
const bancoJugadores = [
    { nombre: "Thibaut Courtois", pos: "POR" }, { nombre: "Marc-André ter Stegen", pos: "POR" },
    { nombre: "Virgil van Dijk", pos: "DEF" }, { nombre: "Ronald Araújo", pos: "DEF" },
    { nombre: "Achraf Hakimi", pos: "DEF" }, { nombre: "Alphonso Davies", pos: "DEF" },
    { nombre: "Jude Bellingham", pos: "MED" }, { nombre: "Kevin De Bruyne", pos: "MED" },
    { nombre: "Pedri", pos: "MED" }, { nombre: "Federico Valverde", pos: "MED" },
    { nombre: "Kylian Mbappé", pos: "DEL" }, { nombre: "Erling Haaland", pos: "DEL" },
    { nombre: "Lionel Messi", pos: "DEL" }, { nombre: "Vinicius Jr.", pos: "DEL" },
    { nombre: "Robert Lewandowski", pos: "DEL" }, { nombre: "Lamine Yamal", pos: "DEL" }
];

let copiaPool = [];
let jugadorActual = null;
let miEquipo = [];
let managerName = "";

// Variables para el temporizador de 1 minuto
let intervaloTiempo = null;
let tiempoRestante = 60; // 60 segundos = 1 minuto

// Almacenamiento local para los mánagers que compiten
let votosGlobales = {
    "DKVAS_Admin": 5,
    "Faker_Fan": 3
};

// Elementos HTML
const authScreen = document.getElementById("auth-screen");
const registroForm = document.getElementById("registro-form");
const usernameInput = document.getElementById("username");
const gameScreen = document.getElementById("game-screen");
const userDisplay = document.getElementById("user-display");
const btnIniciar = document.getElementById("btn-iniciar");
const draftArea = document.getElementById("draft-area");
const jugadorOpcion = document.getElementById("jugador-opcion");
const btnElegir = document.getElementById("btn-elegir");
const btnDescartar = document.getElementById("btn-descartar");
const listaEquipo = document.getElementById("lista-equipo");
const contadorPlantilla = document.getElementById("contador-plantilla");
const btnCompartir = document.getElementById("btn-compartir");
const audioSilbato = document.getElementById("audio-silbato");
const vDinamicosContainer = document.getElementById("votos-dinamicos");
const votingPlaceholder = document.getElementById("voting-placeholder");
const btnReinicioTotal = document.getElementById("btn-reinicio-total");
const timerCountdown = document.getElementById("timer-countdown");
const timerWrapper = document.querySelector(".timer-wrapper");

// Registro
registroForm.addEventListener("submit", (e) => {
    e.preventDefault();
    managerName = usernameInput.value.trim();
    if(managerName) {
        userDisplay.innerText = managerName;
        authScreen.style.display = "none";
        gameScreen.style.display = "block";
        renderizarVotaciones(); 
    }
});

// Iniciar Juego
btnIniciar.addEventListener("click", () => {
    copiaPool = [...bancoJugadores];
    miEquipo = [];
    listaEquipo.innerHTML = "";
    contadorPlantilla.innerText = "0";
    btnCompartir.style.display = "none";
    draftArea.style.display = "flex";
    btnElegir.disabled = false;
    btnDescartar.disabled = false;
    obtenerSiguienteCandidato();
});

// FUNCIÓN DEL TEMPORIZADOR
function iniciarTemporizador() {
    // Limpiar cualquier conteo previo activo
    clearInterval(intervaloTiempo);
    tiempoRestante = 60; // Forzar 1 minuto exacto
    timerWrapper.classList.remove("timer-urgent");
    actualizarRelojVisual();

    intervaloTiempo = setInterval(() => {
        tiempoRestante--;
        actualizarRelojVisual();

        // Efecto visual de pánico a los últimos 10 segundos
        if (tiempoRestante <= 10) {
            timerWrapper.classList.add("timer-urgent");
        }

        // Si el tiempo llega a cero, se le pasa el jugador automáticamente
        if (tiempoRestante <= 0) {
            clearInterval(intervaloTiempo);
            obtenerSiguienteCandidato(); // Salta al siguiente jugador
        }
    }, 1000);
}

function actualizarRelojVisual() {
    const minutos = Math.floor(tiempoRestante / 60);
    const segundos = tiempoRestante % 60;
    
    // Formatear texto para que siempre muestre dos dígitos (ej: 01:05, 00:59)
    const strMinutos = minutos < 10 ? "0" + minutos : minutos;
    const strSegundos = segundos < 10 ? "0" + segundos : segundos;
    
    timerCountdown.innerText = `${strMinutos}:${strSegundos}`;
}

function obtenerSiguienteCandidato() {
    if (miEquipo.length >= 11) {
        clearInterval(intervaloTiempo); // Detener reloj al finalizar
        timerCountdown.innerText = "00:00";
        timerWrapper.classList.remove("timer-urgent");
        
        jugadorOpcion.innerHTML = "🎉 ¡Draft Completado con Éxito!";
        btnCompartir.style.display = "block";
        bloquearControles();
        
        audioSilbato.play().catch(error => console.log("Permiso de audio requerido:", error));
        
        if (!votosGlobales.hasOwnProperty(managerName)) {
            votosGlobales[managerName] = 0; 
            renderizarVotaciones();
        }
        return;
    }
    if (copiaPool.length === 0) {
        clearInterval(intervaloTiempo);
        jugadorOpcion.innerHTML = "🏁 No hay más jugadores.";
        bloquearControles();
        return;
    }
    const index = Math.floor(Math.random() * copiaPool.length);
    jugadorActual = copiaPool.splice(index, 1);
    jugadorOpcion.innerHTML = `<span class="badge-pos">${jugadorActual.pos}</span> ${jugadorActual.nombre}`;
    
    // Lanzar el reloj de un minuto para esta nueva carta
    iniciarTemporizador();
}

btnElegir.addEventListener("click", () => {
    if (jugadorActual && miEquipo.length < 11) {
        miEquipo.push(jugadorActual);
        const fila = document.createElement("li");
        fila.innerHTML = `<span class="badge-pos">${jugadorActual.pos}</span> ${jugadorActual.nombre}`;
        listaEquipo.appendChild(fila);
        contadorPlantilla.innerText = miEquipo.length;
        obtenerSiguienteCandidato(); // Al obtener el siguiente, se refresca el reloj solo
    }
});

btnDescartar.addEventListener("click", obtenerSiguienteCandidato);

function bloquearControles() { 
    btnElegir.disabled = true; 
    btnDescartar.disabled = true; 
    jugadorActual = null; 
}

// Compartir plantilla
btnCompartir.addEventListener("click", () => {
    let textoDraft = `⚽ *DRAFT DE FÚTBOL DKVAS77*\n👑 *Manager:* ${managerName}\n\n*MI ONCE TITULAR:*\n`;
    miEquipo.forEach((j, i) => { textoDraft += `${i + 1}. [${j.pos}] - ${j.nombre}\n`; });
    navigator.clipboard.writeText(textoDraft).then(() => { alert("¡Tu 11 se copió al portapapeles!"); });
});

// RECONSTRUIR LA TABLA DE VOTACIÓN
function renderizarVotaciones() {
    vDinamicosContainer.innerHTML = "";
    const llaves = Object.keys(votosGlobales);
    
    if(llaves.length === 0) {
        votingPlaceholder.style.display = "block";
        return;
    }
    
    votingPlaceholder.style.display = "none";

    let totalVotos = 0;
    llaves.forEach(m => totalVotos += votosGlobales[m]);
    if(totalVotos === 0) totalVotos = 1; 

    llaves.forEach(manager => {
        const pct = Math.round((votosGlobales[manager] / totalVotos) * 100);
        
        const filaVoto = document.createElement("div");
        filaVoto.className = "vote-option";
        filaVoto.innerHTML = `
            <button class="btn-vote-dinamico" data-manager="${manager}">Votar ${manager}</button>
            <div class="progress-bar">
                <div class="progress" style="width: ${pct}%;">${pct}% (${votosGlobales[manager]} votos)</div>
            </div>
        `;
        vDinamicosContainer.appendChild(filaVoto);
    });

    document.querySelectorAll(".btn-vote-dinamico").forEach(boton => {
        boton.onclick = (e) => {
            const mSeleccionado = e.target.getAttribute("data-manager");
            votosGlobales[mSeleccionado]++;
            renderizarVotaciones();
        };
    });
}

// LÓGICA DEL BOTÓN DE REINICIO TOTAL
btnReinicioTotal.addEventListener("click", () => {
    const confirmar = confirm("⚠️ ¿Estás seguro de que quieres BORRAR todas las votaciones y managers actuales para empezar una nueva liga?");
    
    if (confirmar) {
        clearInterval(intervaloTiempo); // Frenar reloj si está corriendo
        votosGlobales = {};
        miEquipo = [];
        managerName = "";
        
        listaEquipo.innerHTML = "";
        contadorPlantilla.innerText = "0";
        jugadorOpcion.innerHTML = "---";
        usernameInput.value = "";
        timerCountdown.innerText = "01:00";
        timerWrapper.classList.remove("timer-urgent");
        
        renderizarVotaciones();
        
        draftArea.style.display = "none";
        gameScreen.style.display = "none";
        authScreen.style.display = "block";
        
        alert("🔄 El torneo ha sido reiniciado. Todos los marcadores vuelven a cero.");
    }
});

body {
    font-family: 'Arial', sans-serif;
    background-color: #1e293b;
    color: #ffffff;
    text-align: center;
    padding: 20px;
}

h1 {
    color: #4ade80;
    margin-bottom: 30px;
}

button {
    background-color: #4ade80;
    color: #0f172a;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
}

button:hover {
    background-color: #22c55e;
}

.draft-container {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 30px;
    flex-wrap: wrap;
}

.current-pick, .my-team {
    background-color: #0f172a;
    padding: 20px;
    border-radius: 12px;
    width: 300px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.card {
    font-size: 24px;
    font-weight: bold;
    padding: 30px;
    margin: 20px 0;
    background: linear-gradient(135deg, #3b82f6, #1d4ed8);
    border-radius: 8px;
    border: 2px solid #60a5fa;
}

ul {
    list-style: none;
    padding: 0;
    text-align: left;
}

li {
    background-color: #1e293b;
    padding: 10px;
    margin: 8px 0;
    border-radius: 6px;
    border-left: 4px solid #4ade80;
}

