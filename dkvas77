            <button id="btn-elegir">Fichar Jugador</button>
            <button id="btn-descartar">Pasar / Siguiente</button>
        </div>

        <!-- Tu plantilla elegida -->
        <div class="my-team">
            <h2>Mi Equipo Formado</h2>
            <ul id="lista-equipo">
                <!-- Los jugadores elegidos aparecerán aquí -->
            </ul>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
